---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard';

// Fetch all non-draft posts and sort by date descending
const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const sortedPosts = posts.sort((a, b) => {
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---

<Layout title="Blog - Nadhif Nadhiftya Putra">
  <div class="pt-32 pb-20 px-6 sm:px-8 max-w-5xl mx-auto">
    <header class="mb-16 text-center">
      <h1 
        class="text-3xl md:text-4xl font-bold mb-4"
        style="font-family: var(--font-serif); color: var(--color-text);"
      >
        Blog & Notes
      </h1>
      <p 
        class="text-base max-w-xl mx-auto leading-relaxed"
        style="color: var(--color-text-2);"
      >
        Writings on technology exploration, software development experiences, and systems notes.
      </p>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <BlogCard
            client:load
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20" style="color: var(--color-text-2);">
        <p>No posts published yet.</p>
      </div>
    )}
  </div>
</Layout>
