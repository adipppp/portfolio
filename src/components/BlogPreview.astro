---
import { getCollection } from 'astro:content';
import { ArrowRight } from "lucide-react";
import BlogCard from './BlogCard';

// Fetch the 3 most recent non-draft posts
const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{recentPosts.length > 0 && (
  <section id="blog-preview" class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/30 text-blue-400 border border-blue-900/50 text-sm font-semibold tracking-wide mb-6">
            Blog
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-100">
            Tulisan Terbaru
          </h2>
        </div>
        <a 
          href="/blog" 
          class="group inline-flex items-center gap-2 text-blue-500 font-medium hover:text-blue-400 transition-colors"
        >
          Lihat Semua Tulisan <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <BlogCard
            client:visible
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
)}
